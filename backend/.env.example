# Copy to backend/.env for local runs (never commit .env)

ENVIRONMENT=local
ALLOW_TEST_AUTH=true
GCP_PROJECT_ID=hackathon2025-472017
FIREBASE_PROJECT_ID=hackathon2025-472017
FIRESTORE_DATABASE_ID=mekasa-db
# memory | firestore | auto (prod defaults to firestore)
HOUSEHOLD_PERSISTENCE=memory
# Path to service-account JSON outside the repo (after you create the key)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/mekasa-api.json
# Set false once real Firebase ID tokens are used:
# ALLOW_TEST_AUTH=false
# Optional: Google Places nearby stores (REQ-003). Falls back to stub without it.
# GOOGLE_PLACES_API_KEY=
# Receipt scanning with Gemini on Vertex AI (uses ADC; falls back to Vision OCR).
# RECEIPT_LLM_ENABLED=true
# GEMINI_RECEIPT_MODEL=gemini-3.1-pro-preview
# GEMINI_LOCATION=global
# Shared Postgres for store item / UPC tables (unset → in memory).
# DATABASE_URL=postgresql://postgres@localhost:5432/mekasa

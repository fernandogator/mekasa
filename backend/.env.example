# Copy to backend/.env for local runs (never commit .env)

ENVIRONMENT=local
ALLOW_TEST_AUTH=true
GCP_PROJECT_ID=hackathon2025-472017
FIREBASE_PROJECT_ID=hackathon2025-472017
FIRESTORE_DATABASE_ID=mekasa-db
# Path to service-account JSON outside the repo (after you create the key)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/mekasa-api.json
# Set false once real Firebase ID tokens are used:
# ALLOW_TEST_AUTH=false

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mekasa.app/schema/firestore/store_chains.schema.json",
  "title": "store_chains/{chain_id}",
  "description": "Retail chains referenced by products and receipts; name is injected into the Gemini prompt as {{store_chain_name}} (REQ-RCP-002).",
  "type": "object",
  "additionalProperties": false,
  "required": ["chain_id", "name", "aliases", "receipt_code_kind", "created_at", "updated_at"],
  "properties": {
    "chain_id": { "$ref": "_common.schema.json#/$defs/storeChainId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 80 },
      "uniqueItems": true
    },
    "website_domain": { "type": ["string", "null"], "maxLength": 120 },
    "receipt_code_kind": { "type": "string", "enum": ["none", "upc", "item_number"] },
    "created_at": { "$ref": "_common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "_common.schema.json#/$defs/timestamp" }
  }
}
